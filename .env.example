# ============================================================================
# Spring Boot Environment Variables - dabom-batch-core
# ============================================================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
#   cp .env.example.md .env
# (.gitignore에 의해 .env는 Git에서 제외됩니다)
# ============================================================================

# --- Profile ---
SPRING_PROFILES_ACTIVE=local

# --- Database (MySQL) ---
DATABASE_URL=jdbc:mysql://localhost:13306/app_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DATABASE_USER=app_user
DATABASE_PASSWORD=app_password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# --- Observability (OpenTelemetry) ---
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Slack Alert ---
SLACK_WEBHOOK_URL=

# --- Batch Global ---
BATCH_JOB_ENABLED=false
BATCH_RETRY_LIMIT=3
BATCH_RETRY_BACKOFF_MILLIS=3000

# --- Batch Schedule: Weekly Family Recap ---
BATCH_WEEKLY_FAMILY_RECAP_ENABLED=true
BATCH_WEEKLY_FAMILY_RECAP_CRON=0 10 0 * * MON

# --- Batch Schedule: Monthly Family Recap ---
BATCH_MONTHLY_FAMILY_RECAP_ENABLED=false
BATCH_MONTHLY_FAMILY_RECAP_CRON=0 20 0 1 * *

# --- Batch Schedule: Monthly Usage Precreate ---
BATCH_MONTHLY_USAGE_PRECREATE_ENABLED=false
BATCH_MONTHLY_USAGE_PRECREATE_CRON=0 30 23 28-31 * *

# --- Batch Schedule: Monthly Usage Reset ---
BATCH_MONTHLY_USAGE_RESET_ENABLED=false
BATCH_MONTHLY_USAGE_RESET_CRON=0 1 0 1 * *

# --- Batch Schedule: DB-Redis Reconciliation ---
BATCH_DB_REDIS_RECONCILIATION_ENABLED=false
BATCH_DB_REDIS_RECONCILIATION_CRON=0 0 3 * * *

# --- Batch Schedule: Usage Event Outbox ---
BATCH_USAGE_EVENT_OUTBOX_ENABLED=false
BATCH_USAGE_EVENT_OUTBOX_FIXED_DELAY=60000
BATCH_USAGE_EVENT_OUTBOX_INITIAL_DELAY=5000

# --- Batch Job Tuning: Weekly Family Recap ---
BATCH_WEEKLY_FAMILY_RECAP_LOCK_TTL=PT1H
BATCH_WEEKLY_FAMILY_RECAP_CHUNK_SIZE=1000
BATCH_WEEKLY_FAMILY_RECAP_DB_FETCH_SIZE=1000

# --- Batch Job Tuning: Monthly Family Recap ---
BATCH_MONTHLY_FAMILY_RECAP_LOCK_TTL=PT1H
BATCH_MONTHLY_FAMILY_RECAP_CHUNK_SIZE=1000
BATCH_MONTHLY_FAMILY_RECAP_DB_FETCH_SIZE=1000

# --- Batch Job Tuning: Monthly Usage Precreate ---
BATCH_MONTHLY_USAGE_PRECREATE_LOCK_TTL=PT1H
BATCH_MONTHLY_USAGE_PRECREATE_DB_FETCH_SIZE=4000

# --- Batch Job Tuning: Monthly Usage Reset ---
BATCH_MONTHLY_USAGE_RESET_LOCK_TTL=PT1H
BATCH_MONTHLY_USAGE_RESET_REDIS_CHUNK_SIZE=2000
BATCH_MONTHLY_USAGE_RESET_DB_FETCH_SIZE=4000

# --- Batch Job Tuning: DB-Redis Reconciliation ---
BATCH_DB_REDIS_RECONCILIATION_LOCK_TTL=PT1H
BATCH_DB_REDIS_RECONCILIATION_REDIS_CHUNK_SIZE=2000
BATCH_DB_REDIS_RECONCILIATION_DB_FETCH_SIZE=4000

# --- Batch Job Tuning: Usage Event Outbox ---
BATCH_USAGE_EVENT_OUTBOX_BATCH_SIZE=100
BATCH_USAGE_EVENT_OUTBOX_CONCURRENCY=8
BATCH_USAGE_EVENT_OUTBOX_MAX_RETRY=5
BATCH_USAGE_EVENT_OUTBOX_RETRY_INITIAL_DELAY=PT1M
BATCH_USAGE_EVENT_OUTBOX_RETRY_MAX_DELAY=PT16M
BATCH_USAGE_EVENT_OUTBOX_RETRY_ELIGIBILITY_DELAY=PT1M
BATCH_USAGE_EVENT_OUTBOX_PUBLISH_TIMEOUT=PT10S
BATCH_USAGE_EVENT_OUTBOX_TOPIC=notification
